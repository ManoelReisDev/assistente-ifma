# A indexação envia trechos; a geração envia pergunta, evidências e limitações à NVIDIA.
NVIDIA_API_KEY=nvapi-exemplo-substitua-localmente

# Limites de consultas POST /api/ask. O launcher lê estes valores do .env.
WEB_RATE_LIMIT_IP_MINUTE=5
WEB_RATE_LIMIT_IP_DAY=20
WEB_RATE_LIMIT_GLOBAL_MINUTE=10
WEB_RATE_LIMIT_GLOBAL_DAY=100
# Opcional: use armazenamento persistente na hospedagem.
# WEB_RATE_LIMIT_DB=data/web/rate-limits.sqlite3
